# PostgreSQL (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Signing key for JWT sessions (min. 16 characters — use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# First admin is created automatically if no admin exists yet
ADMIN_EMAIL="admin@saniga.ch"
ADMIN_PASSWORD="your-secure-password"

# Comma-separated browser origins allowed by CORS (no spaces required).
# On Railway, defaults to https://$RAILWAY_PUBLIC_DOMAIN when unset.
# Local default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS="https://your-app.up.railway.app"

# Invoice start number / VAT / UID are edited under Stammdaten → Firma

# LEGACY — remove from Railway if still present (shared join code retired):
# EMPLOYEE_INVITE_CODE
