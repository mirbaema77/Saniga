# PostgreSQL (Railway: add Postgres plugin, copy DATABASE_URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Signing key for JWT sessions (min. 16 characters — use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# First admin is created automatically if no admin exists yet
ADMIN_EMAIL="admin@saniga.ch"
ADMIN_PASSWORD="your-secure-password"

# Employees must enter this exact code on /join.html to register (share only with your team)
EMPLOYEE_INVITE_CODE="SANIGA-MVP-2026"

# Optional: comma-separated allowed browser origins for CORS (default: allow all)
# CORS_ORIGIN="https://your-app.up.railway.app"
